# Postgres connection (Neon in production). For local development without Postgres:
# DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=
# Apply SQL migrations in ./drizzle on first database use (production)
RUN_MIGRATIONS=1
# Random 32+ byte secret for signing sessions: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public URL of the site
BETTER_AUTH_URL=http://localhost:3000
# Optional: other site addresses allowed to sign in, comma-separated
BETTER_AUTH_TRUSTED_ORIGINS=
