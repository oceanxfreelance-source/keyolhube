# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development

POSTGRES_USER=jigmap
POSTGRES_PASSWORD=jigmap
POSTGRES_DB=jigmap
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
S3_PORT=9000

# S3-compatible storage (SeaweedFS locally; credentials in deploy/seaweedfs/s3.json).
# Production: a managed S3 service with its own credentials.
S3_ACCESS_KEY=jigmap
S3_SECRET_KEY=jigmap-dev-secret
S3_BUCKET=jigmap-data

# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Satellite basemap (see docs/data-sources.md):
#   esri_public_dev        development only, refused when ENVIRONMENT=production
#   esri_location_platform needs ESRI_API_KEY
#   mapbox_satellite       needs MAPBOX_ACCESS_TOKEN
#   maptiler_satellite     needs MAPTILER_API_KEY
#   custom_xyz             needs CUSTOM_XYZ_URL (+ CUSTOM_XYZ_ATTRIBUTION)
# Keys are used server-side only (tile proxy); they are never sent to the app.
SATELLITE_PROVIDER=esri_public_dev
ESRI_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAPTILER_API_KEY=
CUSTOM_XYZ_URL=
CUSTOM_XYZ_ATTRIBUTION=
TILE_TOKEN_HOURS=12
